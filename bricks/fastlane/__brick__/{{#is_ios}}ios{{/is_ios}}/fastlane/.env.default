APPLE_ID="{{apple_id}}"
TEAM_ID="{{team_id}}"
ITC_TEAM_ID="{{itc_team_id}}"
APPSTORE_KEY_ID="{{app_store_key_id}}"
APPSTORE_ISSUER_ID="{{app_store_issuer_id}}"
P8_FILE_PATH="{{{api_key_file_path}}}"
{{#is_git_repo_set}}GIT_REPOSITORY_URL={{git_repo_url}}{{/is_git_repo_set}}{{^is_git_repo_set}}# GIT_REPOSITORY_URL= # the URL of the git repository where the match certificates are stored{{/is_git_repo_set}}
{{#is_match_git_basic_authorization_set}}MATCH_GIT_BASIC_AUTHORIZATION={{match_git_basic_authorization}}{{/is_match_git_basic_authorization_set}}{{^is_match_git_basic_authorization_set}}# MATCH_GIT_BASIC_AUTHORIZATION= # the access token for the git repository where the match certificates are stored{{/is_match_git_basic_authorization_set}}
{{#is_match_keychain_password_set}}MATCH_KEYCHAIN_PASSWORD={{match_keychain_password}}{{/is_match_keychain_password_set}}{{^is_match_keychain_password_set}}# MATCH_KEYCHAIN_PASSWORD= # The password for the keychain used by match{{/is_match_keychain_password_set}}
